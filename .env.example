# Public values live in the committed .env file. Copy this file to .env.local
# only to override them or to add the server-only secrets. Never commit .env.local.
# Required: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY.
# SUPABASE_SERVICE_ROLE_KEY is needed for checkout and the /o/<token> order page
# (the rest of the shop works without it). Optional until images: Cloudinary.
# Live site: set it as a Worker secret: npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY

# Public site URL, used to build order links (https://<site>/o/<token>)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) or legacy anon key. Safe in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) or legacy service_role key. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# SERVER ONLY.
CLOUDINARY_API_SECRET=
